# =============================================================================
# Voice Agent — client environment
# =============================================================================
# Copy to .env and adjust. .env is gitignored — never commit real keys.
#
# Priority: environment / .env > hardcoded default.
# =============================================================================

# speech-to-speech Realtime server the client connects to.
S2S_URL=ws://localhost:8765/v1/realtime

OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
LLM_MODEL=qwen3.7-plus
LOCAL_MODEL=gemma4:e2b

# Client-side behaviour.
# Language for tool descriptions and responses: "ru" or "en".
LANGUAGE=en

# Timer / alarm / reminder scheduling + stored secrets (SQLite, мигрируется при
# старте через yoyo). Clock times are interpreted and shown in 24-hour format.
# TIMEZONE is an IANA name (e.g. Europe/Moscow); empty = system local timezone.
TIMEZONE=UTC

AGENT_DB=.local/agent.db

# Console logging verbosity: debug, info, warning, error, critical.
# Case-insensitive; an unknown value falls back to info.
LOG_LEVEL=info

# Web tools (optional). web_search и read_url работают и без ключей через бесплатный fallback.
# FIRECRAWL_API_KEY — первичный бэкенд для поиска и чтения страниц (https://firecrawl.dev)
FIRECRAWL_API_KEY=
# Jina - второй бэкенд для поиска и чтения страниц (https://jina.ai)
JINA_API_KEY=
# Exa   — третий бэкенд для поиска и чтения страниц (https://exa.ai)
EXA_API_KEY=

# Open-Meteo endpoints (no API key needed). Override only for testing.
# GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Audio: 24 kHz PCM int16 is the OpenAI Realtime wire format for the MIC.
# SAMPLE_RATE=24000
# OUTPUT_SAMPLE_RATE=16000   # TTS playback rate — s2s streams audio at 16 kHz
# INPUT_DEVICE=              # mic name/index; set to the AEC source for echo
#                            # cancellation, e.g. INPUT_DEVICE=echo-cancelled
# 80 ms blocks reduce wake detection and first-command latency.
# BLOCK_SIZE=1920

# A non-empty model enables local wake-word gating. Leave empty for the
# previous always-on microphone mode. Built-in names and custom model filename
# prefixes in WAKE_WORD_MODEL_DIR are supported without an extension.
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_MODEL_DIR=.local/openwakeword
WAKE_WORD_INFERENCE_FRAMEWORK=onnx
WAKE_WORD_THRESHOLD=0.35
WAKE_WORD_GAIN=1.0
WAKE_WORD_PATIENCE=1
WAKE_WORD_COOLDOWN_SEC=1.5
WAKE_WORD_VAD_THRESHOLD=0.5
WAKE_WORD_NOISE_SUPPRESSION=true

# Local activation cue. Mic blocks start flowing to s2s only after this tone
# and its trailing silence have passed through the playback queue.
EARCON_FREQUENCY_HZ=880
EARCON_DURATION_MS=120
EARCON_VOLUME=0.25
POST_EARCON_SILENCE_MS=0

# A lower descending cue means the dialogue window has closed and the next
# command requires the wake word. Wake detection resumes after its silence.
DEACTIVATION_EARCON_START_HZ=660
DEACTIVATION_EARCON_END_HZ=440
DEACTIVATION_EARCON_DURATION_MS=180
DEACTIVATION_EARCON_VOLUME=0.2
POST_DEACTIVATION_EARCON_SILENCE_MS=100

# After each final answer, keep the existing AEC/barge-in stream active for
# follow-up replies and clarification answers. 0 requires a new wake word.
ACTIVATION_LISTEN_TIMEOUT_SEC=8
FOLLOW_UP_WINDOW_SEC=10
MAX_ACTIVE_SEC=90
